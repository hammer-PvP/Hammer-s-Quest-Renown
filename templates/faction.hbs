<div class="hqr-shell">
  <header class="hqr-banner"><i class="fa-solid fa-shield-halved"></i><div><h2>Faction Manager</h2><p>World Journal • Public Profile & GM Notes</p></div><button type="button" data-action="new"><i class="fa-solid fa-plus"></i> New Faction</button></header>
  <div class="hqr-scroll">
    <div class="hqr-two"><label>Existing Factions<select name="existing"><option value="">Create New</option>{{#each factions}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label><label>Faction Name<input name="name" type="text" value="{{name}}" placeholder="Council of the Eastern Coast"></label></div>
    <div class="hqr-panel"><h3><i class="fa-solid fa-eye"></i> Public Content</h3><div class="hqr-faction-image-field">
      <label>Faction Emblem / Image</label>
      <div class="hqr-faction-preview" aria-label="Faction emblem preview">
        <img alt="Faction emblem" hidden>
        <div class="hqr-faction-preview-empty"><i class="fa-regular fa-image"></i><span>Choose an image from Foundry's File Picker</span></div>
      </div>
      <div class="hqr-file-picker-row">
        <input name="image" type="text" value="{{image}}" placeholder="worlds/.../faction.webp" aria-label="Faction image path">
        <button type="button" data-action="browse-image" title="Browse with native Foundry File Picker"><i class="fa-solid fa-folder-open"></i> Browse</button>
        <button type="button" data-action="clear-image" title="Remove emblem"><i class="fa-solid fa-xmark"></i></button>
      </div>
      <p class="hqr-hint">Native Foundry File Picker · 5:3 preview · image preserved without cropping or stretching.</p>
    </div><label>Flavor Text / Description<textarea name="description" rows="5">{{description}}</textarea></label></div>
    <div class="hqr-panel hqr-ranks">
      <div class="hqr-rank-settings-header"><h3><i class="fa-solid fa-book-open"></i> Renown Ranks</h3></div>
      <p class="hqr-hint">Each faction has independent thresholds. Renown can be negative. Existing ranks and reputation are preserved.</p>
      <div class="hqr-list">
        {{#each ranks}}
        <div class="hqr-rank-card" data-rank-id="{{id}}">
          <div class="hqr-rank-row">
            <input type="text" data-field="rank-name" value="{{name}}" placeholder="Rank" aria-label="Rank name">
            <input type="number" data-field="rank-min" value="{{min}}" aria-label="Minimum Renown">
            <button type="button" data-action="remove-rank" title="Remove Rank"><i class="fa-solid fa-trash"></i></button>
          </div>
          <div class="hqr-rank-benefits">
            <h4>Rank Benefits <span class="hqr-foundation-label">Foundation</span></h4>
            <div class="hqr-block-list">
              {{#each benefits}}
              <div class="hqr-benefit-block" data-benefit-id="{{id}}" data-benefit-type="{{type}}">
                <div class="hqr-benefit-head">
                  <span><i class="fa-solid {{#if isGeneral}}fa-users{{else}}fa-user-shield{{/if}}"></i> {{#if isGeneral}}General{{else}}Class Specific{{/if}}</span>
                  <button type="button" data-action="remove-benefit" title="Remove benefit block"><i class="fa-solid fa-xmark"></i></button>
                </div>
                {{#if isGeneral}}
                  <p class="hqr-hint">All eligible Characters. Item and Spell source linking is planned for a later version.</p>
                {{else}}
                  <div class="hqr-class-slot-list">
                    {{#each slots}}
                    <div class="hqr-class-slot {{#if unavailable}}hqr-class-slot-unavailable{{/if}}" data-class-key="{{key}}">
                      <strong class="hqr-class-slot-name">{{name}}</strong>
                      <span class="hqr-class-slot-empty">Empty — optional</span>
                    </div>
                    {{else}}
                    <p class="hqr-hint hqr-no-classes">No classes enabled. Configure them in Module Settings.</p>
                    {{/each}}
                  </div>
                  <p class="hqr-hint">Class slots are optional placeholders; drag-and-drop will follow in a later version.</p>
                {{/if}}
              </div>
              {{/each}}
            </div>
            <div class="hqr-benefit-actions">
              <button type="button" data-action="add-benefit" data-type="general"><i class="fa-solid fa-plus"></i> General</button>
              <button type="button" data-action="add-benefit" data-type="classSpecific"><i class="fa-solid fa-plus"></i> Class Specific</button>
            </div>
          </div>
        </div>
        {{/each}}
      </div>
      <button type="button" class="hqr-quiet" data-action="add-rank"><i class="fa-solid fa-plus"></i> Add Rank</button>
      <p class="hqr-hint">Class Specific slots follow the global Class Catalog. Empty slots are valid and do not grant Items, Feats, Features or Spells to Characters.</p>
    </div>
    <div class="hqr-panel hqr-private"><h3><i class="fa-solid fa-lock"></i> GM Only</h3><label>Private Notes<textarea name="notes" rows="7" placeholder="Secrets, plots, key NPCs, contingencies...">{{notes}}</textarea></label><p class="hqr-hint">This text is stored only on a private JournalEntryPage, never in public Journal flags.</p></div>
  </div>
  <footer class="hqr-actions"><button type="button" data-action="open-journal" {{#unless isEdit}}disabled{{/unless}}>Open Journal</button><button type="button" data-action="save" class="hqr-primary"><i class="fa-solid fa-floppy-disk"></i> Save Faction</button></footer>
</div>
