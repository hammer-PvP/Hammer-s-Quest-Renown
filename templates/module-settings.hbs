<div class="hqr-shell">
  <header class="hqr-banner"><i class="fa-solid fa-gears"></i><div>
    <h2>Module Settings</h2><p>World settings • GM Only • Shared across Factions</p>
  </div></header>
  <div class="hqr-scroll">
    <div class="hqr-panel hqr-class-catalog-panel">
      <details class="hqr-class-catalog-details" data-class-catalog-details>
        <summary class="hqr-class-catalog-summary">
          <span class="hqr-class-catalog-summary-name"><i class="fa-solid fa-list-check"></i> <strong>Class Catalog</strong></span>
          <span class="hqr-class-catalog-summary-actions">
            <span class="hqr-class-catalog-summary-count"><strong data-class-count>{{selectedCount}}</strong> / {{totalClasses}} classes enabled</span>
            <i class="fa-solid fa-chevron-down hqr-class-catalog-chevron" aria-hidden="true"></i>
          </span>
        </summary>
        <div class="hqr-class-catalog-body">
          <p class="hqr-hint">Select which class compendiums (or World Items) this module may use. This does not change the D&amp;D5e Compendium Browser or restrict other spells and feats.</p>
          {{#unless sourcesInitialized}}<p class="hqr-catalog-info">Existing classes and ranks are preserved. Review the source selection and save to lock the intended class versions for this World.</p>{{/unless}}
          {{#if errors.length}}<p class="hqr-catalog-warning">Could not index some compendiums: {{#each errors}}{{this}} {{/each}}</p>{{/if}}
          <div class="hqr-class-source-header"><strong><i class="fa-solid fa-book"></i> Class Sources</strong><small><span data-source-count>0</span> selected</small></div>
          <div class="hqr-class-source-list" data-class-sources>
            {{#each sources}}
            <label class="hqr-class-source-row" title="{{id}} — {{bookLabel}}">
              <input type="checkbox" data-class-source="{{id}}" {{#if enabled}}checked{{/if}}>
              <span><strong>{{name}}</strong><small>{{bookLabel}} · {{count}} class definitions</small></span>
            </label>
            {{else}}
            <p class="hqr-hint">No class compendiums detected in the D&amp;D5e Sources. Check the game system Compendium Browser configuration.</p>
            {{/each}}
          </div>
          <div class="hqr-class-source-header"><strong><i class="fa-solid fa-list-check"></i> Enabled Classes</strong><small>Choose one exact class definition when sources overlap</small></div>
          <div class="hqr-class-catalog-toolbar">
            <input type="search" data-class-search placeholder="Filter class or source" aria-label="Search classes">
            <button type="button" data-action="select-all-classes">Select Visible</button>
            <button type="button" data-action="clear-classes">Clear Visible</button>
          </div>
          <div class="hqr-class-catalog-list" data-class-list>
            {{#each classes}}
            <div class="hqr-class-catalog-entry" data-class-row data-key="{{key}}" data-name="{{name}}" data-pinned-unavailable="{{#if pinnedUnavailable}}true{{else}}false{{/if}}">
              <label class="hqr-class-catalog-row" title="{{name}}">
                <input type="checkbox" data-class-enable aria-label="Enable {{name}}" {{#if enabled}}checked{{/if}}>
                <span class="hqr-class-catalog-text"><strong>{{name}}</strong><small data-class-source-caption>{{sourceLabel}}</small></span>
              </label>
              <select data-class-definition aria-label="Select source for {{name}}" hidden>
                <option value="">Select exact class definition…</option>
                {{#each definitions}}
                <option value="{{uuid}}" data-source-id="{{sourceId}}" data-source-label="{{source}}" {{#if selected}}selected{{/if}}>{{source}} · {{sourceId}}</option>
                {{/each}}
              </select>
            </div>
            {{else}}
            <p class="hqr-hint">No classes found. Check D&amp;D5e Sources or World Items.</p>
            {{/each}}
          </div>
          <p class="hqr-hint">Only the Class Specific slots are affected. Empty slots remain valid.</p>
        </div>
      </details>
    </div>
    <div class="hqr-panel hqr-folder-management">
      <h3><i class="fa-solid fa-folder-tree"></i> Folder Management</h3>
      <p class="hqr-hint">Customize the name and native color of each module-managed Journal folder. The folder roles and Quest status rules remain unchanged. Existing folders are renamed in place, preserving IDs and Journals.</p>
      <div class="hqr-folder-management-head" aria-hidden="true"><span>Folder role / Display name</span><span>Color</span></div>
      {{#each folders}}
      <div class="hqr-folder-management-row">
        <label class="hqr-folder-name-field">
          <span>{{label}}</span>
          <input type="text" data-folder-name="{{key}}" value="{{name}}" maxlength="100" aria-label="Folder name for {{label}}" spellcheck="false">
        </label>
        <div class="hqr-folder-color-field">
          <input type="color" data-folder-color="{{key}}" value="{{color}}" aria-label="Folder color for {{label}}">
          <code data-color-label="{{key}}">{{color}}</code>
        </div>
      </div>
      {{/each}}
      <div class="hqr-folder-management-actions">
        <button type="button" data-action="reset-names" class="hqr-quiet"><i class="fa-solid fa-rotate-left"></i> Reset Default Names</button>
        <button type="button" data-action="reset-colors" class="hqr-quiet"><i class="fa-solid fa-palette"></i> Reset Default Colors</button>
      </div>
    </div>
  </div>
  <footer class="hqr-actions">
    <span class="hqr-hint">Changes apply to this World.</span>
    <button type="button" data-action="save-settings" class="hqr-primary"><i class="fa-solid fa-floppy-disk"></i> Save Settings</button>
  </footer>
</div>
