<div class="hqr-shell">
<header class="hqr-banner"><i class="fa-solid fa-handshake"></i><div><h2>{{#if isGiving}}Quest Giving{{else}}Quest Turn-In{{/if}}</h2><p>{{name}} · {{statusLabel}}</p></div><span class="hqr-pill">GM</span></header>
<div class="hqr-scroll">
{{#if isGiving}}
  {{#if canGive}}
  <div class="hqr-panel"><h3><i class="fa-solid fa-user-check"></i> Assign Quest to Characters</h3>
    <p class="hqr-hint">Characters with a non-GM Player Owner. Group selection is not required for Quest Giving.</p>
    <div class="hqr-people">{{#each pcs}}<label class="hqr-check"><input type="checkbox" name="assignees" value="{{id}}" {{#if checked}}checked{{/if}}>{{name}}</label>{{else}}<p class="hqr-hint">No Player-Owned Characters currently exist.</p>{{/each}}</div>
    <label>Initial State<select name="givenStatus"><option value="offered">Offered</option><option value="accepted">Accepted</option><option value="in-progress">In Progress</option></select></label>
    <p class="hqr-hint">Only assigned Characters' Users receive Journal Observer access, never Owner.</p>
  </div>
  {{else}}<div class="hqr-warning">This Quest must be Available to assign. Change availability in Quest Manager.</div>{{/if}}
{{else}}
  {{#if claimed}}<div class="hqr-warning">Rewards already issued. Turn-In is closed. Use View Results from Quest Manager.</div>
  {{else}}
    <div class="hqr-panel"><h3>Quest Progress</h3>
      {{#if canProgress}}<label>Change Status<select name="progressStatus"><option value="accepted">Accepted</option><option value="in-progress">In Progress</option><option value="completed">Completed (without automatic rewards)</option><option value="failed">Failed</option><option value="abandoned">Abandoned</option></select></label><button data-action="change-status" type="button">Save Status Only</button>{{else}}<p class="hqr-hint">Current: {{statusLabel}}.</p>{{/if}}
    </div>
    {{#if canTurnIn}}
    <div class="hqr-panel"><h3><i class="fa-solid fa-gift"></i> Quest Rewards</h3>
      {{#each currency}}<div class="hqr-balance"><span>{{key}}</span><strong>{{amount}}</strong></div>{{/each}}
      {{#each items}}<div class="hqr-balance"><span>{{name}}</span><strong>×{{quantity}}</strong></div>{{/each}}
      {{#unless hasRenown}}{{#unless hasLoot}}<p class="hqr-hint">No configured rewards. The Quest may still be completed.</p>{{/unless}}{{/unless}}
    </div>
    {{#if payoutPlan}}
    <div class="hqr-warning">A partial reward transaction exists. Retry uses its previously locked recipients and Renown targets, regardless of new selections.</div>
    {{else}}
    <div class="hqr-panel"><h3><i class="fa-solid fa-users"></i> Participating Characters</h3>
      <p class="hqr-hint">Only checked participants receive personal Renown. Membership alone never earns personal points.</p>
      <div class="hqr-people">{{#each participants}}<label class="hqr-check"><input type="checkbox" name="participants" value="{{id}}" {{#if checked}}checked{{/if}}>{{name}}</label>{{else}}<p class="hqr-hint">No eligible Characters assigned to this Quest.</p>{{/each}}</div>
    </div>
    {{#unless noGroups}}
    <div class="hqr-panel"><h3>Represented Groups <small>(Optional)</small></h3>
      <p class="hqr-hint">Only Groups containing at least one checked participant are listed. No Group is auto-selected.</p>
      <div class="hqr-people">{{#each groups}}<label class="hqr-check"><input type="checkbox" name="groups" value="{{id}}" {{#if checked}}checked{{/if}}><span>{{name}}<small class="hqr-group-members">{{people}}</small></span></label>{{/each}}</div>
      <p class="hqr-hint">Leave all unchecked to grant only personal Renown.</p>
    </div>
    {{/unless}}
    {{/if}}
    {{#if hasRenown}}<div class="hqr-panel"><h3>Faction Renown Rewards</h3>
      <p class="hqr-hint">Each line changes selected Characters and/or checked Groups. A Group receives each change once.</p>
      {{#each renown}}
      <div class="hqr-turnin-renown-row" data-reward-id="{{id}}"><strong>{{factionName}}</strong><span class="{{#if positive}}hqr-positive{{else}}hqr-negative{{/if}}">{{amountLabel}}</span>
        {{#unless ../payoutPlan}}<label class="hqr-check"><input type="checkbox" name="targetPersonal" {{#if personal}}checked{{/if}}>Characters</label><label class="hqr-check"><input type="checkbox" name="targetGroup" {{#if group}}checked{{/if}}>Groups</label>{{/unless}}
      </div>{{/each}}
    </div>{{/if}}
    {{#if hasLoot}}<div class="hqr-panel"><label>Currency & Item Inventory Recipient<select name="lootRecipientId" {{#if payoutPlan}}disabled{{/if}}><option value="">Select Actor inventory</option>{{#each inventoryActors}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label></div>{{/if}}
    <div class="hqr-panel"><button type="button" data-action="issue" class="hqr-primary"><i class="fa-solid fa-check"></i> {{#if payoutPlan}}Resume Locked Rewards{{else}}Complete & Grant Rewards{{/if}}</button></div>
    {{/if}}
  {{/if}}
{{/if}}
</div>
<footer class="hqr-actions"><button type="button" data-action="open"><i class="fa-solid fa-book-open"></i> Open Journal</button>{{#if isGiving}}{{#if canGive}}<button type="button" class="hqr-primary" data-action="give"><i class="fa-solid fa-handshake"></i> Give Quest</button>{{/if}}{{/if}}</footer>
</div>
