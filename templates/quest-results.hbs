<div class="hqr-shell">
<header class="hqr-banner"><i class="fa-solid fa-clipboard-check"></i><div><h2>Quest Results</h2><p>{{name}} · {{status}}</p></div><span class="hqr-pill">Read Only</span></header>
<div class="hqr-scroll">
  <div class="hqr-panel"><h3>Individual Character Outcomes</h3>
    {{#each rows}}<div class="hqr-balance"><span>{{name}}</span><span>{{status}} <small>{{at}}</small></span></div>{{else}}<p class="hqr-hint">No Characters assigned.</p>{{/each}}
  </div>
  {{#each resultRows}}
  <div class="hqr-panel"><h3>Turn-In #{{index}} · {{at}}</h3>
    <p><strong>Completed:</strong> {{participants}}</p><p><strong>Represented Groups:</strong> {{groups}}</p>
    {{#each renown}}<div class="hqr-balance"><span>{{faction}}</span><span>{{amount}} · {{#if personal}}Characters{{/if}} {{#if group}}Groups{{/if}}</span></div>{{/each}}
  </div>{{else}}<div class="hqr-panel"><p class="hqr-hint">No completed Turn-Ins yet.</p></div>{{/each}}
  <div class="hqr-panel"><h3>Each — Rewards Defined</h3>
    {{#each currency}}<div class="hqr-balance"><span>{{name}}</span><strong>{{amount}} per Character</strong></div>{{/each}}
    {{#each items}}<div class="hqr-balance"><span>{{name}}</span><strong>×{{quantity}} per Character</strong></div>{{/each}}
  </div>
</div>
<footer class="hqr-actions"><button type="button" data-action="open"><i class="fa-solid fa-book-open"></i> Open Journal</button></footer>
</div>
