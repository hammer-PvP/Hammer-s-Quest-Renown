<div class="hqr-shell">
<header class="hqr-banner"><i class="fa-solid fa-scroll"></i><div><h2>Quest Editor</h2><p>Native Journal • GM-controlled permissions</p></div><span class="hqr-pill">{{#if claimed}}Rewards Claimed{{else}}v0.0.1{{/if}}</span></header>
<div class="hqr-scroll">
  {{#unless hasFac}}<div class="hqr-warning">Create a Faction in Faction Manager before saving a Quest.</div>{{/unless}}
  <div class="hqr-two"><label>Quest Name<input type="text" name="name" value="{{name}}" placeholder="The Missing Relic"></label><label>Quest Faction<select name="factionUuid"><option value="">Choose a Faction</option>{{#each factions}}<option value="{{uuid}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label></div>
  <div class="hqr-two"><label>Status<select name="status">{{#each statusOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label><label>Assignment Mode<select name="assignment"><option value="group" {{#if groupMode}}selected{{/if}}>Group Actor</option><option value="individual" {{#unless groupMode}}selected{{/unless}}>Individual Characters</option></select></label></div>
  <div class="hqr-panel"><h3><i class="fa-solid fa-users"></i> Accepted By</h3><label>Party / Group Actor<select name="groupId"><option value="">Select Group</option>{{#each groups}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label>{{#if groupMode}}<div class="hqr-hint">Eligible Group members (characters with explicit non-GM Owner): {{#each groupParticipants}}<span class="hqr-chip">{{this}}</span>{{else}}None{{/each}}</div>{{else}}<div class="hqr-people">{{#each participants}}<label class="hqr-check"><input type="checkbox" name="assignees" value="{{id}}" {{#if checked}}checked{{/if}}>{{name}}</label>{{else}}<p>No player-owned Characters found.</p>{{/each}}</div>{{/if}}</div>
  <div class="hqr-panel"><h3><i class="fa-solid fa-eye"></i> Public Quest Briefing</h3><label>Flavor Text<textarea name="flavor" rows="6" placeholder="The quest announcement that players will read...">{{flavor}}</textarea></label><h4>Objectives</h4>{{#each objectives}}<div class="hqr-objective"><input type="checkbox" {{#if done}}checked{{/if}} title="Objective complete"><input type="text" value="{{text}}" placeholder="Objective"><button type="button" data-action="remove-objective" data-index="{{index}}"><i class="fa-solid fa-trash"></i></button></div>{{/each}}<button type="button" data-action="add-objective" class="hqr-quiet"><i class="fa-solid fa-plus"></i> Add Objective</button></div>
  <div class="hqr-panel"><h3><i class="fa-solid fa-gift"></i> Public Rewards</h3><h4>Currency</h4><div class="hqr-currencies">{{#each currencies}}<label>{{label}}<input name="currency_{{id}}" type="number" value="{{value}}" min="0" step="1"></label>{{/each}}</div><h4>Item Rewards</h4><div class="hqr-item-drop"><p class="hqr-hint">Drop an Item here from World or Compendium, or enter an Item UUID and select lookup.</p>{{#each items}}<div class="hqr-item-row"><input data-field="uuid" value="{{uuid}}" type="text" placeholder="Item or Compendium UUID"><input data-field="label" value="{{name}}" type="text" placeholder="Name"><input data-field="quantity" value="{{quantity}}" type="number" min="1" step="1" title="Quantity"><button type="button" data-action="lookup-item" title="Resolve UUID"><i class="fa-solid fa-magnifying-glass"></i></button><button type="button" data-action="remove-item" data-index="{{index}}" title="Remove"><i class="fa-solid fa-trash"></i></button></div>{{/each}}<button type="button" class="hqr-quiet" data-action="add-item"><i class="fa-solid fa-plus"></i> Add Item</button></div>
  <div class="hqr-two"><label>Faction Renown (+/-)<input name="renown" type="number" step="1" value="{{renown}}"></label><label>Renown Recipients<select name="renownScope"><option value="group" {{#if renownGroup}}selected{{/if}}>Group Reputation</option><option value="individual" {{#unless renownGroup}}selected{{/unless}}>Eligible Participants</option></select></label></div>
  <label>Currency & Item Destination<select name="lootRecipientId"><option value="">Choose a Character or Group</option>{{#each lootActors}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label><p class="hqr-hint">Currency and physical Items go to one selected Actor inventory. Renown is awarded separately using the selected mode.</p></div>
  <div class="hqr-panel hqr-private"><h3><i class="fa-solid fa-lock"></i> GM Only</h3><label>Private Notes<textarea name="notes" rows="7" placeholder="Secrets, plot twists, hidden objectives and GM plans...">{{notes}}</textarea></label><p class="hqr-hint">Saved in a separate private JournalEntryPage with no Player access.</p></div>
</div>
<footer class="hqr-actions"><button type="button" data-action="open-journal" {{#unless isEdit}}disabled{{/unless}}>Open Journal</button><button type="button" class="hqr-claim" data-action="award" {{#unless canAward}}disabled{{/unless}}><i class="fa-solid fa-gift"></i> Grant Rewards</button><button type="button" data-action="save" class="hqr-primary"><i class="fa-solid fa-floppy-disk"></i> Save Quest</button></footer>
</div>
