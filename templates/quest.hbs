<div class="hqr-shell">
<header class="hqr-banner"><i class="fa-solid fa-scroll"></i><div><h2>Quest Editor</h2><p>Design the Quest here; use Quest Giving & Turn-In for assignment and rewards.</p></div><span class="hqr-pill">{{statusLabel}}</span></header>
<div class="hqr-scroll">
  <div class="hqr-two"><label>Quest Name<input name="name" type="text" value="{{name}}" placeholder="The Missing Relic"></label><label>Owner Faction<select name="factionUuid" {{#if ownerLocked}}disabled{{/if}}><option value="" {{#if noOwner}}selected{{/if}}>No Faction — Independent Quest</option>{{#if missingOwner}}<option value="{{missingOwnerUuid}}" selected>Missing Faction (unresolved)</option>{{/if}}{{#each factions}}<option value="{{uuid}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label></div>
  {{#if missingOwner}}<div class="hqr-warning">This Quest references a missing Owner Faction. It will not be converted automatically. You can retain this existing reference or, before any payout, explicitly choose No Faction or another valid Faction.</div>{{/if}}
  <p class="hqr-hint">Owner Faction is optional. Independent Quests can still award or deduct Renown for existing Factions through the reward and failure rows. {{#if ownerLocked}}Owner Faction is locked because a payout or Turn-In exists.{{/if}}</p>
  <p class="hqr-hint">New Quests are saved as Unavailable without any recipients. Availability and recipients are controlled separately in Quest Manager.</p>
  <div class="hqr-panel"><h3><i class="fa-solid fa-eye"></i> Public Quest Briefing</h3><label>Flavor Text<textarea name="flavor" rows="6" placeholder="The description players will read...">{{flavor}}</textarea></label>
    <h4>Objectives</h4><div class="hqr-objectives hqr-list">{{#each objectives}}<div class="hqr-objective"><input type="checkbox" {{#if done}}checked{{/if}} title="Complete"><input type="text" value="{{text}}" placeholder="Objective"><button type="button" data-action="remove-objective" title="Remove"><i class="fa-solid fa-trash"></i></button></div>{{/each}}</div>
    <button type="button" class="hqr-quiet" data-action="add-objective"><i class="fa-solid fa-plus"></i> Add Objective</button>
  </div>
  <div class="hqr-panel"><h3><i class="fa-solid fa-gift"></i> Announced Rewards</h3>
    {{#if claimed}}<div class="hqr-warning">At least one Character has completed this Quest. Reward definitions are locked to preserve Each payouts.</div>{{/if}}
    <h4>Currency</h4><div class="hqr-currencies">{{#each currencies}}<label>{{label}}<input name="currency_{{id}}" type="number" value="{{value}}" min="0" step="1" {{#if ../claimed}}readonly{{/if}}></label>{{/each}}</div>
    <h4>Items</h4><div class="hqr-item-drop" data-locked="{{claimed}}"><div class="hqr-drop-prompt"><i class="fa-solid fa-box-open"></i> Drag & Drop Items from the World or Compendiums here</div><div class="hqr-items hqr-list">{{#each items}}<div class="hqr-item-row"><div class="hqr-item-label"><img class="hqr-item-img" src="{{img}}" alt=""><span class="hqr-item-name">{{name}}</span><input type="hidden" data-field="uuid" value="{{uuid}}"></div><label class="hqr-qty">Qty.<input type="number" data-field="quantity" min="1" step="1" value="{{quantity}}" {{#if ../claimed}}readonly{{/if}}></label><button type="button" data-action="remove-item" title="Remove Item" {{#if ../claimed}}disabled{{/if}}><i class="fa-solid fa-trash"></i></button></div>{{/each}}</div></div>
    <h4>Faction Renown Rewards</h4>
    <div class="hqr-renown-rewards hqr-list">{{#each renownRewards}}
      <div class="hqr-renown-reward" data-reward-id="{{id}}">
        <label class="hqr-renown-faction">Faction<select data-field="faction" {{#if ../claimed}}disabled{{/if}}>{{#each choices}}<option value="{{uuid}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label>
        <label class="hqr-renown-amount">Renown (+/-)<input data-field="amount" type="number" step="1" value="{{amount}}" {{#if ../claimed}}readonly{{/if}}></label>
        <button type="button" data-action="remove-renown" title="Remove Renown reward" {{#if ../claimed}}disabled{{/if}}><i class="fa-solid fa-trash"></i></button>
      </div>{{/each}}</div>
    <button type="button" class="hqr-quiet" data-action="add-renown" {{#if claimed}}disabled{{/if}}><i class="fa-solid fa-plus"></i> Add Renown Reward</button>
    <p class="hqr-hint">The recipients and reward distribution mode will be selected when the Quest is turned in.</p>
  </div>
  <div class="hqr-panel hqr-failure-editor">
    <h3><i class="fa-solid fa-shield-xmark"></i> Failure Penalties <small>(Optional · GM Only)</small></h3>
    <label class="hqr-check"><input type="checkbox" name="failurePenaltiesEnabled" {{#if failurePenaltiesEnabled}}checked{{/if}} {{#if failureClaimed}}disabled{{/if}}>Enable Failure Penalties</label>
    {{#if failureClaimed}}<p class="hqr-warning">A Failure Turn-In was already issued; failure penalty definitions are locked to protect the records.</p>{{/if}}
    <div class="hqr-failure-penalty-controls" {{#unless failurePenaltiesEnabled}}hidden{{/unless}}>
      <p class="hqr-hint">On a Failed Turn-In, apply these negative Renown amounts to selected Characters and optionally represented Groups. No normal Success rewards are paid. This section is not shown in player Journals.</p>
      <div class="hqr-failure-penalties hqr-list">{{#each failurePenalties}}
        <div class="hqr-renown-reward hqr-failure-penalty" data-penalty-id="{{id}}">
          <label class="hqr-renown-faction">Faction<select data-field="faction" {{#if ../failureClaimed}}disabled{{/if}}>{{#each choices}}<option value="{{uuid}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label>
          <label class="hqr-renown-amount">Renown (negative)<input type="number" data-field="amount" max="-1" step="1" value="{{amount}}" {{#if ../failureClaimed}}readonly{{/if}}></label>
          <button type="button" data-action="remove-failure" title="Remove penalty" {{#if ../failureClaimed}}disabled{{/if}}><i class="fa-solid fa-trash"></i></button>
        </div>{{/each}}</div>
      <button type="button" class="hqr-quiet" data-action="add-failure" {{#if failureClaimed}}disabled{{/if}}><i class="fa-solid fa-plus"></i> Add Failure Penalty</button>
    </div>
  </div>
  <div class="hqr-panel hqr-private"><h3><i class="fa-solid fa-lock"></i> GM Only</h3><label>Private Notes<textarea name="notes" rows="7" placeholder="Secrets, plots and GM-only notes...">{{notes}}</textarea></label><p class="hqr-hint">Separate private Journal page, unavailable to players.</p></div>
</div>
<footer class="hqr-actions"><button type="button" data-action="open-journal" {{#unless isEdit}}disabled{{/unless}}>Open Journal</button><button type="button" data-action="manage"><i class="fa-solid fa-list-check"></i> Quest Manager</button><button type="button" class="hqr-primary" data-action="save"><i class="fa-solid fa-floppy-disk"></i> Save Quest</button></footer>
</div>
