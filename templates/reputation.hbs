<div class="hqr-shell">
<header class="hqr-banner"><img class="hqr-banner-identity" src="modules/hammer-s-quest-renown/assets/book-feather.svg" alt=""><div><h2>Reputation Manager</h2><p>Group & Character Renown</p></div><span class="hqr-pill">{{#if gm}}GM Access{{else}}Read Only{{/if}}</span></header>
<div class="hqr-scroll">
<label>Actor<select name="actorId">{{#each actors}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label>
<div class="hqr-panel"><h3>Known Factions</h3>{{#each balances}}<div class="hqr-balance"><span><strong>{{name}}</strong><small>{{rank}}</small></span><strong>{{value}}</strong></div>{{else}}<p class="hqr-hint">This Actor has no recorded Renown yet.</p>{{/each}}</div>
{{#if gm}}<div class="hqr-panel"><h3><i class="fa-solid fa-pen-to-square"></i> Manual Adjustment</h3><div class="hqr-two"><label>Faction<select name="factionUuid">{{#each factions}}<option value="{{uuid}}">{{name}}</option>{{/each}}</select></label><label>Renown Change<input name="amount" type="number" step="1" value="0"></label></div><label>Reason (required)<textarea name="reason" rows="3" placeholder="What happened? Why is this faction reacting?"></textarea></label><p class="hqr-hint">Zero establishes a known Faction without changing the numerical balance.</p><button type="button" class="hqr-primary" data-action="apply" {{#unless hasActor}}disabled{{/unless}}>Record Adjustment</button></div>{{/if}}
<div class="hqr-panel"><h3><i class="fa-solid fa-clock-rotate-left"></i> History</h3>{{#each ledger}}<div class="hqr-history"><span><strong>{{factionName}}</strong> <span class="hqr-delta">{{deltaLabel}}</span><small>{{reason}}</small><small>{{source}} · {{at}}</small></span></div>{{else}}<p class="hqr-hint">No reputation events recorded.</p>{{/each}}</div>
</div></div>
